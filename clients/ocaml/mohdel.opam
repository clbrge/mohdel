# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Client for the mohdel thin-gate: one call for 13 providers or local inference"
description:
  "Streams events from a mohdel thin-gate over its unix socket: chat completions with tool calls and vision, image generation, speech to text, per-call USD cost. Synchronous, stdlib Unix transport, yojson."
maintainer: ["Christophe Le Bars <clb@toort.net>"]
authors: ["Christophe Le Bars <clb@toort.net>"]
license: "MIT"
homepage: "https://github.com/clbrge/mohdel"
bug-reports: "https://github.com/clbrge/mohdel/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0"}
  "yojson" {>= "2.0"}
  "ocamlformat" {with-dev-setup & = "0.27.0"}
  "alcotest" {with-test & >= "1.5"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/clbrge/mohdel.git"
