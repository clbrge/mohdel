{
  "name": "mohdel",
  "version": "3.0.0",
  "license": "MIT",
  "author": {
    "name": "Christophe Le Bars",
    "email": "clb@toort.net"
  },
  "description": "Self-hosted LLM gateway and SDK for Node — a LiteLLM-style unified API for 13 providers (Anthropic, OpenAI, Gemini, Mistral, Groq, xAI, DeepSeek, OpenRouter, …) with per-call USD cost tracking, streaming, tool calls, vision, speech-to-text, and built-in OpenTelemetry. Run in-process, or behind the process-isolated thin-gate for fault containment.",
  "type": "module",
  "keywords": [
    "llm",
    "llm-gateway",
    "ai-gateway",
    "ai-sdk",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "mistral",
    "groq",
    "deepseek",
    "openrouter",
    "streaming",
    "tool-calling",
    "token-cost",
    "rate-limiting",
    "opentelemetry",
    "self-hosted",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clbrge/mohdel.git"
  },
  "homepage": "https://github.com/clbrge/mohdel#readme",
  "bugs": {
    "url": "https://github.com/clbrge/mohdel/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "src/lib/index.js",
  "exports": {
    ".": {
      "types": "./src/lib/index.d.ts",
      "default": "./src/lib/index.js"
    },
    "./providers": {
      "types": "./src/lib/providers.d.ts",
      "default": "./src/lib/providers.js"
    },
    "./creators": {
      "types": "./src/lib/creators.d.ts",
      "default": "./src/lib/creators.js"
    },
    "./utils": {
      "types": "./src/lib/utils.d.ts",
      "default": "./src/lib/utils.js"
    },
    "./errors": {
      "types": "./js/core/errors.d.ts",
      "default": "./js/core/errors.js"
    },
    "./client": {
      "types": "./js/client/index.d.ts",
      "default": "./js/client/index.js"
    },
    "./session": {
      "types": "./js/session/index.d.ts",
      "default": "./js/session/index.js"
    },
    "./session/bin": {
      "types": "./js/session/bin.d.ts",
      "default": "./js/session/bin.js"
    }
  },
  "imports": {
    "#core": "./js/core/index.js",
    "#core/*": "./js/core/*"
  },
  "bin": {
    "mo": "src/cli/index.js"
  },
  "files": [
    "js",
    "src/lib",
    "src/cli",
    "config",
    "README.md",
    "LICENSE",
    "js/**/*.d.ts",
    "src/lib/**/*.d.ts"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "standard",
    "clean:types": "find js src/lib -name '*.d.ts' -delete",
    "build:types": "npm run clean:types && tsc -p tsconfig.build.json",
    "test": "npm run test:js && npm run test:rust",
    "test:js": "vitest run test/unit",
    "test:rust": "cargo test --manifest-path rust/thin-gate/Cargo.toml && cargo test --manifest-path rust/napi-addon/Cargo.toml",
    "prerelease": "npm run lint && npm run build:types && npm run test",
    "release": "release-it",
    "test:provider": "vitest run test/integration/provider.test.js",
    "test:multiturn": "vitest run test/integration/multiturn.test.js",
    "test:vision": "vitest run test/integration/vision.test.js",
    "test:vision:catalog": "vitest run test/integration/vision-catalog.test.js",
    "test:live": "vitest run test/live"
  },
  "release-it": {
    "hooks": {
      "before:bump": "grep -q '^## \\[${version}\\]' CHANGELOG.md || (echo 'CHANGELOG.md is missing a ## [${version}] section — add it before releasing.' >&2 && exit 1)",
      "after:bump": "node scripts/sync-version.js && npm install --package-lock-only --ignore-scripts && cargo update --workspace"
    },
    "git": {
      "commitMessage": "release: v${version}",
      "requireUpstream": false,
      "tagName": "v${version}",
      "push": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true,
      "releaseName": "mohdel v${version}",
      "releaseNotes": "awk '/^## \\[${version}\\]/{flag=1;next}/^## \\[/{flag=0}flag' CHANGELOG.md"
    }
  },
  "optionalDependencies": {
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "chalk": "^6.0.0",
    "mohdel-thin-gate-linux-x64-gnu": "3.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@cerebras/cerebras_cloud_sdk": "^1.91.0",
    "@clack/prompts": "^1.8.1",
    "@google/genai": "^2.24.0",
    "@opentelemetry/api": "^1.9.1",
    "env-paths": "^4.0.0",
    "groq-sdk": "^1.6.0",
    "openai": "^7.23.0",
    "undici": "^7.29.0"
  },
  "lint-staged": {
    "*.{js,cjs}": "standard"
  },
  "devDependencies": {
    "gpt-tokenizer": "^4.0.0",
    "lint-staged": "^17.5.1",
    "release-it": "^21.0.3",
    "standard": "^17.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "types": "./src/lib/index.d.ts"
}
