# mohdel environment file: every case here must parse the same in Node (util.parseEnv) and Rust (LocalAuth).
PLAIN=abc123

SPACED = padded value  
export EXPORTED=exp
export  EXPORTED_TWO_SPACES=exp2
INLINE=value # trailing comment
HASH_NO_SPACE=abc#def
DQ="double quoted # not a comment"
SQ='single quoted'
BQ=`back quoted`
DQ_NEWLINE_ESCAPE="line1\nline2"
SQ_NEWLINE_ESCAPE='line1\nline2'
DQ_OTHER_ESCAPES="a\tb and a\\b"
DQ_INNER_QUOTE="say \"hi\""
QUOTED_THEN_COMMENT="x" # c
SQ_HASH='a#b'
EMPTY=
EQUALS=a=b=c
DUP=first
DUP=second
NO_EQUALS_LINE_IS_SKIPPED
=empty key is skipped
  LEADING=spaces
lower_case=lower
KEY_WITH-DASH=dash
DQ_MULTI="multi
line"
SQ_MULTI='multi
line'
AFTER_DQ="x"
  # c=d
UNTERMINATED="no close
AFTER_UNTERMINATED=after
LAST=   